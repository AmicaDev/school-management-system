# Copy to backend/.env (local) - never commit the real file. In hosting dashboards set these as environment variables.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=development
TIME_ZONE=Africa/Kampala

# Database: either a single URL (Render, Railway, Neon, Supabase) ...
DATABASE_URL=
DATABASE_SSL_REQUIRE=False
# ... or separate values
DATABASE_NAME=school_db
DATABASE_USER=school_user
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Redis / Celery. Leave blank to run background tasks inline (no worker needed).
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_EAGER=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@school.local

SERVE_MEDIA=True
SECURE_SSL_REDIRECT=True
ALLOW_WEB_MIGRATIONS=False
AUTO_MAKEMIGRATIONS=False
BUILD_ID=dev

# First-start account creation for hosts without a shell (remove after first start)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEVELOPER_USERNAME=
BOOTSTRAP_DEVELOPER_EMAIL=
BOOTSTRAP_DEVELOPER_PASSWORD=
